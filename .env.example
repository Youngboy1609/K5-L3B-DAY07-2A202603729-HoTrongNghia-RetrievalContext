# Lab7 local settings. Fill only OPENROUTER_API_KEY below.
# Never commit the filled .env or paste the key into chat/logs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_PROVIDER=wafer
OPENROUTER_CORE_PROVIDER=wafer
OPENROUTER_ALLOW_FALLBACKS=false

# Local total API ceiling; existing usage ledger is included.
API_BUDGET_USD=1.50
API_PILOT_BUDGET_USD=0.25

# Local-only PostgreSQL connections. Lab6 must be queried read-only.
DAY6_DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
LAB7_DATABASE_URL=postgresql://lab7:lab7_local_only@127.0.0.1:55434/lab7_agentic

# Bounded DB connection attempts when Docker is unavailable.
PGCONNECT_TIMEOUT=10
